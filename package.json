{
  "name": "@tselect/url",
  "version": "1.0.0",
  "description": "URL related utilities.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "cov": "vitest run --coverage",
    "lint": "tslint --project ./",
    "fix": "tslint --fix --project ./",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm lint && pnpm cov && pnpm build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tselect-npm/url.git"
  },
  "author": "Sylvain Estevez",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "bugs": {
    "url": "https://github.com/tselect-npm/url/issues"
  },
  "homepage": "https://github.com/tselect-npm/url#readme",
  "devDependencies": {
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "^4.1.10",
    "tslint": "6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^4.9.5",
    "vitest": "^4.1.10"
  }
}
